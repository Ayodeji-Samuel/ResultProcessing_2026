# Copy this file to .env and update values.
# Do NOT commit your real .env file.

FLASK_CONFIG=production
SECRET_KEY=replace-with-a-long-random-secret

# --- Production (DigitalOcean / any PostgreSQL) ---
# DATABASE_URL=postgresql://username:password@host:25060/database_name?sslmode=require

# --- Local development with Laragon MySQL ---
# Use 127.0.0.1 instead of localhost to avoid IPv6 resolution issues on Windows
# DATABASE_URL=mysql+mysqldb://root:@127.0.0.1/result_processing_system

# --- Local development with PostgreSQL ---
# DATABASE_URL=postgresql://postgres:password@localhost/result_processing_system

# Leave DATABASE_URL unset to use the default SQLite fallback (instance/results.db)

# Optional app host/port for local testing
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Optional protection for admin bootstrap command
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-one-time-token
