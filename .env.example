# Copy this file to .env and update values.
# Do NOT commit your real .env file.

FLASK_CONFIG=production
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://username:password@host:25060/database_name?sslmode=require

# Optional app host/port for local testing
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Optional protection for admin bootstrap command
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-one-time-token
